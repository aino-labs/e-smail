{
  "compilerOptions": {
    "strict": true,
    "target": "ES6",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@react/*": ["./src/react/*"],
      "@icons/*": ["./public/assets/svg/*"],
    },
    "typeRoots": ["./node_modules/@types", "./src/types"],
  },
  "include": ["src/**/*", "src/App.tsx"],
  "exclude": ["node_modules"],
}
