{
  "compilerOptions": {
    "strict": true,
    "target": "ES6",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@react/*": ["./src/react/*"],
      "@icons": ["./src/assets/svg/index.ts"],
    },
    "typeRoots": ["./node_modules/@types", "./src/types"],
  },
  "include": ["src/**/*", "src/App.tsx", "public/assets/svg/**/*"],
  "exclude": ["node_modules"],
}
